{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "event_v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "cluster_id", "class", "scope", "scope_targets", "t_start", "t_end", "n_items", "n_mentions", "n_sources", "n_outlets", "sources", "sentiment_mean", "confidence_mean", "item_impact_agg", "breadth_term", "impact", "representative_signal_ids"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "cluster_id": {"type": "string", "minLength": 1},
    "class": {"enum": ["geopolitical", "macroeconomic", "credit_event", "commodity_energy", "regulatory", "merger_acquisition", "earnings_corporate", "product_launch", "other"]},
    "scope": {"enum": ["single_name", "sector", "country", "macro", "none"]},
    "scope_targets": {"type": "array", "items": {"type": "string"}},
    "t_start": {"type": "string"},
    "t_end": {"type": "string"},
    "n_items": {"type": "integer", "minimum": 1},
    "n_mentions": {"type": "integer", "minimum": 1},
    "n_sources": {"type": "integer", "minimum": 1},
    "n_outlets": {"type": "integer", "minimum": 0},
    "sources": {"type": "array", "items": {"type": "string"}},
    "sentiment_mean": {"type": "number", "minimum": -1, "maximum": 1},
    "confidence_mean": {"type": "number", "minimum": 0, "maximum": 1},
    "item_impact_agg": {"type": "number", "minimum": 1, "maximum": 10},
    "breadth_term": {"type": "number", "minimum": 0},
    "impact": {"type": "number", "minimum": 1, "maximum": 10},
    "representative_signal_ids": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "string"}}
  }
}
